<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PlayniteWebEmulator</AssemblyName>
    <RootNamespace>PlayniteWebEmulator</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.16.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="SharpCompress" Version="0.26.0">
      <!-- Playnite 10 supplies this exact assembly at runtime. The reported advisories
           affect WriteToDirectory helpers, which this plugin deliberately does not use;
           EmulatorJsRuntimeInstaller validates and writes every entry itself. -->
      <ExcludeAssets>runtime</ExcludeAssets>
      <NoWarn>NU1902</NoWarn>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\PipeProtocol.cs" Link="Protocol\PipeProtocol.cs" />
    <None Update="extension.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\NOTICE" Link="NOTICE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlayniteWebEmulator.Launcher\PlayniteWebEmulator.Launcher.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyLauncher" AfterTargets="Build">
    <ItemGroup>
      <LauncherFiles Include="..\PlayniteWebEmulator.Launcher\bin\$(Configuration)\net462\PlayniteWebEmulator.Launcher.exe" />
      <LauncherFiles Include="..\PlayniteWebEmulator.Launcher\bin\$(Configuration)\net462\PlayniteWebEmulator.Launcher.pdb"
                     Condition="Exists('..\PlayniteWebEmulator.Launcher\bin\$(Configuration)\net462\PlayniteWebEmulator.Launcher.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(LauncherFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
